{
  "name": "aux-wars-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run convex\" \"npm run client\"",
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && node index.js",
    "convex": "npx convex dev",
    "client": "cd client && npm run dev",
    "install-all": "npm install && cd client && npm install && cd ../server && npm install",
    "test": "concurrently \"npm run test:client\" \"npm run test:server\"",
    "test:convex": "vitest run --config vitest.config.mts",
    "typecheck:convex": "tsc --noEmit -p convex",
    "test:client": "cd client && npm test",
    "test:server": "cd server && npm test",
    "test:client:watch": "cd client && npm run test:ui",
    "test:client:coverage": "cd client && npm run test:coverage",
    "build": "cd client && npm run build",
    "deploy:client": "cd client && vercel --prod",
    "deploy:server": "cd server && railway up"
  },
  "dependencies": {
    "@convex-dev/presence": "^0.3.2",
    "convex": "^1.28.0",
    "youtube-search-api": "^2.0.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.1.1",
    "concurrently": "^9.1.2",
    "convex-test": "^0.0.54",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
